### **七、pytest在实际项目中的应用**
#### 案例：测试ERC-20转账功能
```python
import pytest
from web3 import Web3

@pytest.fixture
def erc20_contract(w3, get_contract):
    code = """
    contract ERC20 {
        mapping(address => uint) public balance;
        function transfer(address to, uint amount) public {
            require(balance[msg.sender] >= amount, "Insufficient balance");
            balance[msg.sender] -= amount;
            balance[to] += amount;
        }
    }
    """
    return get_contract(code)

def test_transfer(erc20_contract, w3):
    # 初始化余额
    owner = w3.eth.accounts[0]
    receiver = w3.eth.accounts[1]
    erc20_contract.transfer(receiver, 100, transact={'from': owner})
    
